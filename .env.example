# --- Payload CMS (admin panel at /admin) ---
# Supabase Postgres connection string. Use the Session pooler URI from
# Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres.qxafrrtbolqbfhvsyhcl:YOUR-DB-PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# --- Supabase (learner auth and data) ---
NEXT_PUBLIC_SUPABASE_URL=https://qxafrrtbolqbfhvsyhcl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Storage for admin uploads (optional locally) ---
# Supabase > Project Settings > Storage > S3 Connection. Leave blank to store uploads in ./media.
SUPABASE_S3_ENDPOINT=https://qxafrrtbolqbfhvsyhcl.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-west-2
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Site URL (used for Mux upload CORS) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Mux video (Settings > Access Tokens in the Mux dashboard; needs Mux Video read + write) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux dashboard > Settings > Webhooks: point it at <your site>/api/mux/webhook and paste the signing secret here.
MUX_WEBHOOK_SIGNING_SECRET=
